        "outputId": "768bfd8e-3203-4a75-e722-2bd15f2bedc6"
      },
      "source": [
        "# Ejemplo E - recorrer lista con índices\n",
        "nombres = [\"Ana\", \"Beatriz\", \"Claudia\", \"Diana\", \"Elvira\"]\n",
        "\n",
        "for i in range( len(nombres) ):\n",
        "    print( i, nombres[i] )"
      ],
      "execution_count": 12,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "0 Ana\n",
            "1 Beatriz\n",
            "2 Claudia\n",
            "3 Diana\n",
            "4 Elvira\n"
