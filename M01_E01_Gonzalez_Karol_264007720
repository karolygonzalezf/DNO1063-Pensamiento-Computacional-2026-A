        "outputId": "342165e0-a335-43fc-8bae-935dedb2f049"
      },
      "source": [
        "# Ejemplo B - decisión con if/else\n",
        "a = 3\n",
        "\n",
        "if a == 5:\n",
        "    print( \"a vale 5\" )\n",
        "else:\n",
        "    print( \"a NO vale 5\" )"
      ],
      "execution_count": 9,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "a NO vale 5\n"
          ]
        }
      ]
