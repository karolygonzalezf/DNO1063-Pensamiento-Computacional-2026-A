      "source": [
        "# Ejemplo D - lista y acceso por index\n",
        "nombres = [\"Ana\", \"Beatriz\", \"Claudia\", \"Diana\", \"Elvira\"]\n",
        "\n",
        "print( nombres[0] )  # primer elemento\n",
        "print( nombres[4] )  # quinto elemento"
      ],
      "execution_count": 11,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Ana\n",
            "Elvira\n"
